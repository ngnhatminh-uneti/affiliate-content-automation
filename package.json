{
  "name": "affiliate-content-automation",
  "version": "2.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "remotion:studio": "remotion studio src/remotion/index.tsx",
    "desktop": "electron .",
    "desktop:dev": "concurrently -k \"next dev -p 3210\" \"wait-on http://127.0.0.1:3210 && cross-env ELECTRON_DEV_SERVER_URL=http://127.0.0.1:3210 electron .\"",
    "desktop:build": "npm run build && electron-builder",
    "setup:local": "powershell -ExecutionPolicy Bypass -File scripts/setup-local-ai.ps1"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.522",
    "@remotion/player": "4.0.522",
    "@remotion/renderer": "4.0.522",
    "electron": "^37.1.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.522",
    "zod": "^3.24.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron-builder": "^26.0.20",
    "tailwindcss": "^4.0.0",
    "wait-on": "^8.0.3"
  },
  "engines": { "node": ">=20" },
  "build": {
    "appId": "com.affiliatestudio.desktop",
    "productName": "Affiliate Studio",
    "asar": true,
    "files": ["electron/**/*", ".next/**/*", "public/**/*", "src/**/*", "next.config.*", "package.json", "postcss.config.mjs"],
    "directories": { "output": "dist" },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "mac": { "target": ["dmg"] },
    "linux": { "target": ["AppImage"] }
  }
}
